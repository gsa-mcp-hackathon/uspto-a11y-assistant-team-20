# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (Databricks Apps) you usually leave this as stdio: app.py
# automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── API Keys ─────────────────────────────────────────────────────────────────
# The MCP server itself needs none — it scans publicly reachable pages/images
# over plain HTTP(S), no auth key required. Add a variable here (and a
# matching typed field in src/alt_text_mcp/config.py) if a future tool needs
# one. Never commit the filled-in .env.

# ─── Phoenix Evaluation Harness (eval/phoenix/) ───────────────────────────────
# Only needed to run the eval harness, not the server itself. Models run via
# AWS Bedrock — AGENT_MODEL/JUDGE_MODEL are Bedrock model ids or
# application-inference-profile ARNs. Standard boto3 credential resolution
# applies: set AWS_PROFILE/AWS_REGION (or rely on the default AWS config/SSO
# already set up for this account) — no separate API key needed.
# Model the agent-under-test drives.
AGENT_MODEL=
# Model the LLM-as-judge uses — keep distinct from AGENT_MODEL (ideally
# stronger) to reduce self-preference bias.
JUDGE_MODEL=
